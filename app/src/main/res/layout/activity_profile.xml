<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F8F0">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile" android:textSize="28sp" android:textStyle="bold" android:textColor="#245B36"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:layout_marginTop="18dp" android:background="@drawable/bg_fitness_card" android:elevation="5dp">
                <TextView android:id="@+id/profileInitial" android:layout_width="76dp" android:layout_height="76dp" android:gravity="center" android:text="U" android:textSize="30sp" android:textStyle="bold" android:textColor="#245B36" android:background="@drawable/bg_profile_avatar"/>
                <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/user_label" android:textSize="23sp" android:textStyle="bold" android:textColor="#202820" android:layout_marginTop="14dp"/>
                <TextView android:id="@+id/profileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#687568" android:textSize="14sp"/>
                <TextView android:id="@+id/profileGoalChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fitness goal" android:textColor="#245B36" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="14dp" android:background="@drawable/bg_lime_pill"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your fitness preferences" android:textSize="19sp" android:textStyle="bold" android:textColor="#245B36" android:layout_marginTop="24dp" android:layout_marginBottom="10dp"/>
            <TextView android:id="@+id/profilePreferences" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:lineSpacingExtra="8dp" android:textColor="#354135" android:textSize="15sp" android:background="@drawable/bg_fitness_card"/>
            <Button android:id="@+id/editPreferencesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/update_preferences" android:layout_marginTop="22dp" android:backgroundTint="#245B36"/>
            <Button android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" android:backgroundTint="#A8DF3D" android:textColor="#173D25"/>
            <Button android:id="@+id/profileSignOutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_out" android:backgroundTint="#E8EFE3" android:textColor="#245B36"/>
        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/bottomNavigation" layout="@layout/bottom_navigation" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>