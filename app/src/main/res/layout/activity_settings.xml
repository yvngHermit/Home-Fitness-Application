<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F8F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings" android:textSize="28sp" android:textStyle="bold" android:textColor="#245B36"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_preferences" android:textStyle="bold" android:textColor="#A8DF3D" android:layout_marginTop="22dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/language_settings" android:layout_marginTop="12dp"/>
        <Spinner android:id="@+id/languageSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/language_options"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/theme_settings" android:layout_marginTop="12dp"/>
        <Spinner android:id="@+id/themeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/theme_options"/>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/notificationsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notifications_enabled" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nutrition_goals" android:textStyle="bold" android:textColor="#A8DF3D" android:layout_marginTop="26dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_calorie_target" android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/calorieTargetInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:hint="@string/calorie_target_hint"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weight_measurement" android:layout_marginTop="10dp"/>
        <Spinner android:id="@+id/weightUnitSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/weight_units"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/meal_schedule" android:textStyle="bold" android:textColor="#A8DF3D" android:layout_marginTop="26dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/breakfast_time_range" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/breakfastTimeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/breakfast_times"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lunch_time_range" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/lunchTimeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/lunch_times"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dinner_time_range" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/dinnerTimeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/dinner_times"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workout_reminders" android:textStyle="bold" android:textColor="#A8DF3D" android:layout_marginTop="26dp"/>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/workoutReminderSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_workout_reminder"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_time" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/workoutTimeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/workout_times"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_privacy" android:textStyle="bold" android:textColor="#A8DF3D" android:layout_marginTop="26dp"/>
        <Button android:id="@+id/privacyInfoButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_information" android:backgroundTint="#E8EFE3" android:textColor="#245B36"/>
        <Button android:id="@+id/settingsSignOutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_out" android:backgroundTint="#E8EFE3" android:textColor="#245B36"/>
        <Button android:id="@+id/saveSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/save" android:backgroundTint="#6AFF00" android:textColor="#173D25" android:layout_marginTop="26dp"/>
        <Button android:id="@+id/backSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/back" android:backgroundTint="@color/black"/>
    </LinearLayout>
</ScrollView>