<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_title" android:textSize="25sp" android:textStyle="bold" android:textColor="#2D7138" android:layout_marginBottom="18dp"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/fitness_goal" android:textStyle="bold"/><Spinner android:id="@+id/goalSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/goal_options"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/experience_level" android:textStyle="bold" android:layout_marginTop="12dp"/><Spinner android:id="@+id/experienceSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/experience_options"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/equipment" android:textStyle="bold" android:layout_marginTop="12dp"/><Spinner android:id="@+id/equipmentSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/equipment_options"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/days_per_week" android:textStyle="bold" android:layout_marginTop="12dp"/><Spinner android:id="@+id/daysSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/days_options"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/workout_minutes" android:textStyle="bold" android:layout_marginTop="12dp"/><Spinner android:id="@+id/minutesSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/minutes_options"/>
        <TextView android:layout_width="match_parent" android:textColor="#55CC32" android:layout_height="wrap_content" android:text="@string/diet_preference" android:textStyle="bold" android:layout_marginTop="12dp"/><Spinner android:id="@+id/dietSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/diet_options"/>
        <EditText android:id="@+id/allergiesInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/allergies" android:inputType="textCapSentences"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><EditText android:id="@+id/ageInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/age" android:inputType="number"/><EditText android:id="@+id/heightInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/height_cm" android:inputType="numberDecimal"/><EditText android:id="@+id/weightInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/weight_kg" android:inputType="numberDecimal"/></LinearLayout>
        <Button android:id="@+id/saveOnboardingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/continue_text" android:backgroundTint="#55CC32" android:textColor="#111111" android:layout_marginTop="22dp"/>
    </LinearLayout></ScrollView>
